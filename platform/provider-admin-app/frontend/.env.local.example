# Provider-Admin Frontend — copy to .env.local and fill in values
# App runs on PORT 3002; backend API runs on PORT 4002

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Backend API base URL (provider-admin-app backend on 4002)
NEXT_PUBLIC_API_URL=http://localhost:4002
